# Credenciais de e-mail (Gmail)
# Use uma "Senha de App" do Google, não a senha da conta.
# Ative em: https://myaccount.google.com/apppasswords
EMAIL_REMETENTE=seuemail@gmail.com
EMAIL_SENHA=xxxx_xxxx_xxxx_xxxx
EMAIL_DESTINATARIO=destino@gmail.com

# Câmera (0 = webcam padrão; use 1, 2... para outras câmeras ou RTSP URL)
CAMERA_INDEX=0
# Reconexão contínua: intervalo (s) entre tentativas se a câmera cair / não abrir
CAMERA_RECONNECT_SEC=2
# Quantos frames inválidos seguidos até forçar reabrir o dispositivo
CAMERA_BAD_FRAMES_REOPEN=45

# Detecção de placa (OpenCV — sem YOLO)
# Largura máxima usada na detecção (0 = frame inteiro; ex.: 960 acelera em HD)
DETECC_MAX_LARGURA=960
# Proporção largura/altura do retângulo candidato
PLACA_ASPECT_MIN=1.6
PLACA_ASPECT_MAX=6.0
# Fração da área do frame: mínimo e máximo do candidato
PLACA_AREA_MIN_FRAC=0.0008
PLACA_AREA_MAX_FRAC=0.25
CANNY_LOW=50
CANNY_HIGH=150
# 1 = inclui busca por região clara (placa reflexiva); 0 = só bordas
DETECC_USAR_MASCARA_BRANCO=1
DETECC_MAX_CANDIDATOS=5
DETECC_NMS_IOU=0.35

# Caminhos de dados (criados automaticamente)
DB_PATH=data/database.db
IMAGES_PATH=data/images
REPORTS_PATH=data/relatorios

# Horário de envio do relatório diário (formato HH:MM)
HORARIO_RELATORIO=23:59

# Segundos de espera antes de registrar a mesma placa novamente
COOLDOWN_PLACA=60
